<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <GeneratedRoot Condition="'$(GeneratedRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\validation\generated</GeneratedRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
    <ProjectReference Include="$(GeneratedRoot)\SmokeAvalonia\SmokeAvalonia.Desktop\SmokeAvalonia.Desktop.csproj" />
  </ItemGroup>
</Project>
