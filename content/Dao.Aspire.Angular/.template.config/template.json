{
  "$schema": "http://json.schemastore.org/template",
  "author": "DaoCodes",
  "classifications": ["Web", "Angular", "Aspire"],
  "identity": "Dao.Aspire.Angular.Template",
  "name": ".NET Aspire with Angular",
  "shortName": "dao-aspire-angular",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Dao.Aspire.Angular",
  "preferNameDirectory": true,
  "symbols": {
    "Auth": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Authentication for Angular and the API. See the generated docs/authentication.md for provider setup.",
      "defaultValue": "None",
      "choices": [
        { "choice": "None", "description": "No authentication." },
        { "choice": "GoogleCookie", "description": "Google sign-in with an HttpOnly application session cookie." },
        { "choice": "GoogleJwt", "description": "Google sign-in with Identity, OpenIddict JWTs, and SQLite persistence." },
        { "choice": "MSAL", "description": "Single-tenant Microsoft Entra sign-in with MSAL and a protected API." }
      ]
    },
    "IncludeAuthentication": {
      "type": "computed",
      "value": "(Auth != \"None\")"
    },
    "GoogleCookie": {
      "type": "computed",
      "value": "(Auth == \"GoogleCookie\")"
    },
    "GoogleJwt": {
      "type": "computed",
      "value": "(Auth == \"GoogleJwt\")"
    },
    "MSAL": {
      "type": "computed",
      "value": "(Auth == \"MSAL\")"
    },
    "Google": {
      "type": "computed",
      "value": "(GoogleCookie || GoogleJwt)"
    },
    "IncludeSignalR": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add a SignalR hub to the API and a live notification service + badge component to the Angular app.",
      "defaultValue": "false"
    }
  },
  "specialCustomOperations": {
    "**/*.js": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["//#if"],
            "else": ["//#else"],
            "elseif": ["//#elseif"],
            "endif": ["//#endif"],
            "evaluator": "C++",
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.ts": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["//#if"],
            "else": ["//#else"],
            "elseif": ["//#elseif"],
            "endif": ["//#endif"],
            "evaluator": "C++",
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "exclude": ["auth-assets/**"]
        },
        {
          "condition": "(IncludeAuthentication)",
          "exclude": ["Dao.Aspire.Angular.Web/package.json"]
        },
        {
          "condition": "(GoogleJwt || MSAL)",
          "exclude": ["Dao.Aspire.Angular.Web/package-lock.json"]
        },
        {
          "condition": "(!IncludeAuthentication)",
          "exclude": [
            "Dao.Aspire.Angular.Api/Authentication/**",
            "Dao.Aspire.Angular.Web/src/app/auth/**",
            "Dao.Aspire.Angular.Web/scripts/**",
            "docs/**"
          ]
        },
        {
          "condition": "(!GoogleCookie)",
          "exclude": [
            "Dao.Aspire.Angular.Api/Authentication/GoogleCookie/**",
            "Dao.Aspire.Angular.Web/src/app/auth/cookie-provider.ts"
          ]
        },
        {
          "condition": "(!GoogleJwt)",
          "exclude": [
            "Dao.Aspire.Angular.Api/Authentication/GoogleJwt/**",
            "Dao.Aspire.Angular.Web/src/app/auth/jwt-provider.ts"
          ]
        },
        {
          "condition": "(!MSAL)",
          "exclude": [
            "Dao.Aspire.Angular.Api/Authentication/Entra/**",
            "Dao.Aspire.Angular.Web/src/app/auth/msal-provider.ts"
          ]
        },
        {
          "condition": "(!IncludeSignalR)",
          "exclude": [
            "Dao.Aspire.Angular.Api/Hubs/**",
            "Dao.Aspire.Angular.Web/src/app/signalr/**"
          ]
        },
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/.vscode/**",
            "**/.azure/**",
            "**/node_modules/**",
            "**/.angular/**",
            "**/dist/**",
            "**/coverage/**",
            "**/.certificates/**",
            "**/authentication.db*",
            "**/*.pfx",
            "**/*.key"
          ]
        }
      ]
    },
    {
      "source": "auth-assets/GoogleCookie",
      "target": "Dao.Aspire.Angular.Web",
      "condition": "(GoogleCookie)"
    },
    {
      "source": "auth-assets/GoogleJwt",
      "target": "Dao.Aspire.Angular.Web",
      "condition": "(GoogleJwt)"
    },
    {
      "source": "auth-assets/MSAL",
      "target": "Dao.Aspire.Angular.Web",
      "condition": "(MSAL)"
    }
  ]
}
